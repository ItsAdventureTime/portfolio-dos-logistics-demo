# DOS FreightFlow Control — environment example
# Copy to .env and fill with real values. NEVER commit .env.
# Secrets must be at least 32 bytes. In production, inject via secret manager.

# Environment: development | staging | production | demo
APP_ENV=development

# HTTP listen address (loopback only; Caddy proxies in production)
HTTP_ADDR=127.0.0.1:8080

# PostgreSQL connection (use sslmode=require in production)
DATABASE_URL=postgres://dos:dos@127.0.0.1:5432/dosfreightflow?sslmode=disable

# Session signing secret (>=32 bytes). Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-32-plus-byte-random-secret-value

# OTP signing secret (>=32 bytes). Generate: openssl rand -hex 32
OTP_SECRET=replace-with-32-plus-byte-random-secret-value

# Show OTP codes in dev logs. MUST be false in production.
APP_DEV_CODE_VISIBLE=true

# HTTP timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s

# Logging level: debug | info | warn | error
LOG_LEVEL=info