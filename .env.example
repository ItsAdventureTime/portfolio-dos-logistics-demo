# DOS FreightFlow Control — Environment Configuration
#
# Copy this file to .env and fill in real values. Never commit .env.
# All secrets must be at least 32 bytes. In production, inject them through
# a secret manager rather than a file.

# Environment: development, staging, production, or demo
APP_ENV=development

# HTTP listen address. Keep this on loopback in production; Caddy proxies
# in front of it.
HTTP_ADDR=127.0.0.1:8080

# PostgreSQL connection string. Use sslmode=require in production.
DATABASE_URL=postgres://dos:dos@127.0.0.1:5432/dosfreightflow?sslmode=disable

# Session signing secret. Must be at least 32 bytes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-plus-byte-random-secret-value

# OTP signing secret. Must be at least 32 bytes.
# Generate with: openssl rand -hex 32
OTP_SECRET=replace-with-32-plus-byte-random-secret-value

# Show OTP codes in development logs. Set to false in production.
APP_DEV_CODE_VISIBLE=true

# HTTP timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s

# Log level: debug, info, warn, or error
LOG_LEVEL=info