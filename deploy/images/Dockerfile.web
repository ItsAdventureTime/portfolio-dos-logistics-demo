# Multi-stage build for the DOS FreightFlow Control web client.
# Stage 1: install dependencies and build the production bundle.
# Stage 2: serve static files with Caddy.
#
# Caddy serves the built assets and proxies API requests to the backend.

FROM node:22-alpine AS builder

WORKDIR /build

# Cache dependency install — copy lock files first.
COPY web/package.json web/package-lock.json ./
RUN npm ci --silent

# Copy source and build.
COPY web/ ./
RUN npm run build

# Stage 2: Caddy serves static files.
FROM caddy:2-alpine

# Copy the Caddyfile and built assets.
COPY deploy/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /build/dist /srv

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -qO- http://127.0.0.1:8080/ || exit 1